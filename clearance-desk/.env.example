# === Vercel / deployment env vars ===
# Paste these in Vercel: Project Settings > Environment Variables
# (Set for Production; also Preview if needed)

# --- Public (safe for browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Supabase Dashboard shows "Publishable key" (sb_publishable_...) — use it as the anon/publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
# Set to your deployed URL, e.g. https://cd-fedex.vercel.app (no trailing slash). Used for customer links in emails.
NEXT_PUBLIC_APP_URL=https://your-vercel-app-url.vercel.app

# --- Server-only (NEVER expose as NEXT_PUBLIC_) ---
# Supabase Dashboard shows "Secret key" (sb_secret_...) — use as service role/server key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-or-service-role-key

# Supabase Storage bucket (create in Supabase Storage, private)
SUPABASE_STORAGE_BUCKET=clearance-documents

# --- SMTP (pre-alert emails) ---
MAIL_DRIVER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM=your-smtp-from@example.com
